{
  "name": "citera-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Citera 溯源知识库 · 前端（Vue 3.5 + TS + Vite）",
  "scripts": {
    "dev": "vite",
    "mock": "vite --mode mock",
    "build": "npm run typecheck && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "npm run typecheck:ts && npm run typecheck:vue",
    "typecheck:ts": "tsc --noEmit -p tsconfig.json",
    "typecheck:vue": "node tools/vue-tsc-compat.cjs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "element-plus": "2.14.7",
    "marked": "18.1.1",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "typescript-legacy": "npm:typescript@5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
