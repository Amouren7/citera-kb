# =============================================================================
# Citera 部署环境变量样例（compose / 免费容器平台用）
#   本地：cp deploy/.env.example deploy/.env
#   平台：把下面需要的键逐个填到平台的环境变量面板
# 后端代码里的注释版样例见 backend/.env.example（契约 §6）
# =============================================================================

# --- 必填（生产）-------------------------------------------------------------
# 平台托管的 PostgreSQL 连接串。注意：驱动必须是 psycopg（不是 psycopg2）
# 例：postgresql+psycopg://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://citera:citera@localhost:5432/citera

# 生产必须替换为 32 位以上随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-not-for-production-32chars

# --- 运行环境 ---------------------------------------------------------------
ENV=prod
DEBUG=false

# --- 演示模式（无外网、无 LLM Key 也能完整演示，契约 §0）---------------------
SEED_DEMO_DATA=true
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
LLM_PROVIDER=echo

# --- 可选：接真实模型（OpenAI 兼容接口）-------------------------------------
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat

# --- 检索与切分（不改就用契约默认值）----------------------------------------
RETRIEVAL_MODE=hybrid
TOP_K=5
RRF_K=60
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- 上传与限流 -------------------------------------------------------------
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true

# --- 端口（平台若注入 PORT，这里不用填）-------------------------------------
PORT=8000

# --- 本地 compose 专用：数据库容器账号 --------------------------------------
POSTGRES_USER=citera
POSTGRES_PASSWORD=citera
POSTGRES_DB=citera
POSTGRES_PORT=5432
API_PORT=8000
